<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test target for ORION's input helper: a window that logs every key, character,
       mouse button, wheel and drag it receives, so tests check what really arrived. -->
  <PropertyGroup>
    <AssemblyName>input-probe</AssemblyName>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>11.0</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
</Project>
