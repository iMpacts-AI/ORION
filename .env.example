# ORION Cloud AI Fabric Environment Template
# Copy this file to .env and populate your free-tier provider credentials.
# All keys remain strictly isolated within the Electron Main process.

# 1. Groq LPU Cloud (https://console.groq.com)
GROQ_API_KEY=

# 2. Google Gemini API (https://aistudio.google.com)
GEMINI_API_KEY=

# 3. GitHub Models (https://github.com/marketplace/models)
GITHUB_TOKEN=

# 4. Cerebras Wafer Engine (https://cloud.cerebras.ai)
CEREBRAS_API_KEY=

# 5. Mistral AI Cloud (https://console.mistral.ai)
MISTRAL_API_KEY=

# 6. NVIDIA NIM Catalog (https://build.nvidia.com)
NVIDIA_API_KEY=

# 7. DeepSeek Cloud (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# 8. Cloudflare Workers AI (https://dash.cloudflare.com)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
