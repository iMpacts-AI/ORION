{
  "name": "orion",
  "version": "1.0.0",
  "description": "ORION - Cross-Platform Autonomous AI Command-Line Interface (CLI) & Agent System for macOS, Linux, and Windows",
  "main": "bin/orion.js",
  "bin": {
    "orion": "./bin/orion.js"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node bin/orion.js",
    "cli": "node bin/orion.js",
    "mcp": "node bin/orion.js /mcp",
    "doctor": "node bin/orion.js doctor",
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc && node node_modules/vite/bin/vite.js build",
    "test": "node run_suites.cjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "install:cli": "node bin/install-cli.js",
    "setup:cli": "node bin/install-cli.js",
    "package": "node node_modules/electron-builder/cli.js --dir",
    "dist:portable": "node node_modules/electron-builder/cli.js --win portable"
  },
  "build": {
    "appId": "com.orion.assistant",
    "productName": "ORION",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dir"
    },
    "linux": {
      "target": "dir"
    },
    "forceCodeSigning": false
  },
  "dependencies": {
    "@lucide/lab": "^0.1.0",
    "ansi-escapes": "^4.3.2",
    "cheerio": "^1.0.0-rc.12",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "execa": "^5.1.1",
    "glob": "^10.4.5",
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
